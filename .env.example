# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=product_ticket_api
# Full connection string used by Knex/tests; keep in sync with the vars above.
DATABASE_URL=postgres://app:app@db:5432/product_ticket_api

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Cache
PRODUCTS_CACHE_TTL_SECONDS=120
